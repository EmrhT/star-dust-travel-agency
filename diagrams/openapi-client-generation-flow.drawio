        <mxCell id="check-start" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;" value="Developer or CI&#xa;./scripts/check-api-client.sh&#xa;arguments: none" vertex="1">
