        <mxCell id="check-backup" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;" value="mktemp -d + cp&#xa;backup both inputs&#xa;result: temporary copies" vertex="1">
          <mxGeometry height="90" width="240" x="720" y="115" as="geometry" />
        </mxCell>
        <mxCell id="check-generate" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#F3E8FF;strokeColor=#9333EA;" value="generate-api-client.sh&#xa;build + temporary API + NSwag&#xa;result: regenerated artifacts" vertex="1">
          <mxGeometry height="95" width="280" x="1050" y="110" as="geometry" />
        </mxCell>
        <mxCell id="check-failure" parent="check-1" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;" value="Generator&#xa;exit 0?" vertex="1">
          <mxGeometry height="120" width="170" x="1105" y="290" as="geometry" />
        </mxCell>
        <mxCell id="check-compare" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E0F2FE;strokeColor=#0284C7;" value="cmp -s(backup, regenerated)&#xa;for OpenAPI and TypeScript&#xa;result: two comparison statuses" vertex="1">
          <mxGeometry height="95" width="300" x="710" y="305" as="geometry" />
        </mxCell>
        <mxCell id="check-current" parent="check-1" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCFCE7;strokeColor=#16A34A;" value="Both&#xa;identical?" vertex="1">
          <mxGeometry height="125" width="180" x="410" y="290" as="geometry" />
        </mxCell>
        <mxCell id="check-stale" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FEE2E2;strokeColor=#DC2626;" value="Report each stale path&#xa;result: intended exit code 1" vertex="1">
          <mxGeometry height="85" width="245" x="120" y="500" as="geometry" />
        </mxCell>
        <mxCell id="check-fresh" parent="check-1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCFCE7;strokeColor=#16A34A;" value="Report artifacts current&#xa;result: intended exit code 0" vertex="1">
