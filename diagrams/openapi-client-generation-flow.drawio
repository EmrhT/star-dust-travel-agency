        <mxCell id="check-subtitle" parent="check-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" value="The same deterministic generator is used for updates and verification; cleanup restores the developer or CI checkout." vertex="1">
