        <mxCell id="b4" edge="1" parent="1" style="edgeStyle=none;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;" value="6. HTTP 400 ValidationProblemDetails; service and database are not called"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="745" as="sourcePoint" /><mxPoint x="782" y="745" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b5" edge="1" parent="1" style="edgeStyle=none;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;" value="7. Response { ok: false, status: 400 }"><mxGeometry relative="1" as="geometry"><mxPoint x="782" y="800" as="sourcePoint" /><mxPoint x="557" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b6" edge="1" parent="1" style="edgeStyle=none;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;" value="8. throw Error(&#39;The API returned HTTP 400.&#39;)"><mxGeometry relative="1" as="geometry"><mxPoint x="557" y="850" as="sourcePoint" /><mxPoint x="327" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF7ED;strokeColor=#FB923C;fontSize=12;" value="The global QueryClient retry count is 1, so TanStack may execute queryFn once more before exposing isError. App's Retry button calls journeysQuery.refetch()." vertex="1"><mxGeometry height="85" width="610" x="450" y="845" as="geometry" /></mxCell>

