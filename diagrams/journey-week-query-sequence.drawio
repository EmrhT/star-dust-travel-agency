        <mxCell id="section-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontStyle=1;fillColor=#EFF6FF;strokeColor=#60A5FA;opacity=30;" value="A — Frontend rejects a non-Monday before any network request" vertex="1"><mxGeometry height="250" width="1960" x="10" y="190" as="geometry" /></mxCell>
        <mxCell id="a1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" value="1. isMonday(dateValue: string): boolean → false"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="250" /><mxPoint x="190" y="300" /></Array><mxPoint x="107" y="250" as="sourcePoint" /><mxPoint x="107" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a2" edge="1" parent="1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" value="2. useQuery({ enabled: false })"><mxGeometry relative="1" as="geometry"><mxPoint x="107" y="350" as="sourcePoint" /><mxPoint x="327" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF7ED;strokeColor=#FB923C;fontSize=12;" value="TanStack Query does not call queryFn. App renders the Monday warning. This improves UX, but it is not an API security boundary." vertex="1"><mxGeometry height="95" width="700" x="500" y="315" as="geometry" /></mxCell>

