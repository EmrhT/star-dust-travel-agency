        <mxCell id="d-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF7ED;strokeColor=#FB923C;fontSize=12;" value="The same CancellationToken can propagate through ASP.NET Core and EF Core if the server observes the disconnected request. Cancellation avoids stale work; it is not an error shown to the user." vertex="1"><mxGeometry height="100" width="720" x="850" y="1515" as="geometry" /></mxCell>
