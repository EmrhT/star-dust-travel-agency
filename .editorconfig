# Aligns whitespace rules across the backend, frontend, and documentation.
# Editors use these settings while language-specific tools handle semantics.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.{cs,csproj,json,jsonc,md,ts,tsx,yaml,yml}]
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
