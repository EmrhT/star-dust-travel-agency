# Documents local values consumed by docker-compose.yml service variables.
# Copy this file to .env so containers share ports and PostgreSQL credentials.
# Docker Compose host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Local PostgreSQL configuration. Use a different secret outside development.
POSTGRES_DB=star_dust
POSTGRES_USER=star_dust
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Keycloak shares PostgreSQL but owns a separate database and login role.
KEYCLOAK_PORT=8081
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-keycloak-database-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password
